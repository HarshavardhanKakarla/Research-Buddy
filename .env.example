# Required: Pinecone project key for the shared vector index.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=research-assistant

# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Enable secure session cookies when serving over HTTPS.
COOKIE_SECURE=true

# Optional only for the batch-ingestion CLI. Web visitors enter their own
# OpenAI API key, which the app keeps in process memory for their session.
# OPENAI_API_KEY=
